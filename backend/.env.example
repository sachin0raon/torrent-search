# ─── Required ────────────────────────────────────────────────────────────────

# TMDB API key (server-side only, never exposed to the browser).
TMDB_API_KEY=your_tmdb_api_key_here

# Default forum base URL (no trailing slash). Overridable from the UI at runtime;
# the UI/redirect override is persisted to config.json and takes precedence.
FORUM_BASE_URL=https://example-forum.tld


# ─── Forum base-URL probe ────────────────────────────────────────────────────
# Background job that periodically searches the forum and auto-persists a new
# base URL when the domain has redirected. Values below are the defaults.

# Enable/disable the probe (true/false/1/0/yes/no/on/off).
#FORUM_PROBE_ENABLED=true
# How often to probe, in minutes (floored at 1).
#FORUM_PROBE_INTERVAL_MINUTES=30
# Search term used to probe; must return a valid forum response.
#FORUM_PROBE_QUERY=a


# ─── Outbound retry policy ───────────────────────────────────────────────────
# Retry behaviour for outbound GET calls (TMDB / torrentio / forum). Defaults shown.

# Max attempts per request.
#EXTERNAL_MAX_ATTEMPTS=3
# Initial backoff, in seconds.
#EXTERNAL_BACKOFF_BASE=0.3
# Max backoff per wait, in seconds.
#EXTERNAL_BACKOFF_CAP=3.0
# Random jitter added to each wait, in seconds.
#EXTERNAL_BACKOFF_JITTER=0.5
# Overall time budget across all attempts, in seconds.
#EXTERNAL_RETRY_DEADLINE=15.0


# ─── Discover (trending / popular / top-rated) cache ─────────────────────────
# In-process TTL for cached Discover rail responses, in seconds. Lower means
# fresher lists but more TMDB calls; higher means fewer calls but staler lists.

#DISCOVER_CACHE_TTL_SECONDS=3600


# ─── Authentication ──────────────────────────────────────────────────────────
# SQLite database for users, sessions, and the stream-token signing key.
# In Docker this defaults to /data/auth.db; local runs default to backend/auth.db.
#AUTH_DB_PATH=/data/auth.db
# Override the signing key instead of generating and storing one in the DB.
#AUTH_SIGNING_KEY=change-me
# Absolute login session lifetime, in seconds (default 7 days).
#AUTH_SESSION_TTL_SECONDS=604800
# Player URL token lifetime, in seconds (default 12 hours).
#AUTH_STREAM_TOKEN_TTL_SECONDS=43200
# Force Secure cookies on/off. Unset = automatic from X-Forwarded-Proto.
#AUTH_COOKIE_SECURE=true
# The Go streamer used to verify download ownership before issuing a token.
#STREAMER_BASE_URL=http://127.0.0.1:8001


# ─── Logging & static serving ────────────────────────────────────────────────

# Log level: DEBUG / INFO / WARNING / ERROR. Defaults to INFO.
#LOG_LEVEL=INFO
# Directory of the built React SPA to serve. Defaults to ../static (backend/static);
# leave unset in dev, where Vite serves the frontend instead.
#STATIC_DIR=/path/to/frontend/dist


# ─── Advanced / testing ──────────────────────────────────────────────────────

# Override the config.json location (used by the test suite). Defaults to the
# backend root next to pyproject.toml.
#CONFIG_JSON_PATH=/path/to/config.json
